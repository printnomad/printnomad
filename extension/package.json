{
  "name": "printnomad-extension",
  "version": "0.1.0",
  "private": true,
  "description": "PrintNomad browser extension: converts 3MF projects from model repositories for your printer",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "build": "node build.mjs && npm run build:css",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts ../tools/report-worker/test/*.test.js",
    "test:e2e": "node tests/e2e.mjs && node tests/e2e-makerworld.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "pyodide": "314.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
